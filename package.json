{
  "name": "vianexis-public-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:hero": "node scripts/check-hero-layout.mjs",
    "test:brand": "node scripts/check-brand-story.mjs",
    "test:locale": "node scripts/test-country-locale-policy.mjs",
    "test:legal": "node scripts/check-legal-content.mjs && node scripts/validate-legal-config.mjs",
    "test:quote": "npx --yes tsx --test scripts/test-quote-questionnaire.ts",
    "test:assessment": "npx --yes tsx --test scripts/test-company-assessment-labels.ts",
    "test:integrations": "npx --yes tsx --test scripts/test-enterprise-integration-labels.ts",
    "test:telematics": "npx --yes tsx --test scripts/test-telematics-integrations.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-locales.mjs && npm run test:locale && npm run test:hero && npm run test:brand && npm run test:legal && npm run test:quote && npm run test:assessment && npm run test:integrations && npm run test:telematics && npm run lint && npm run typecheck && npm run build",
    "adr:sync": "node scripts/sync-adr-content.mjs",
    "adr:validate": "node scripts/validate-adr-content.mjs --local",
    "adr:validate:live": "node scripts/validate-adr-content.mjs --live",
    "smoke:public": "node scripts/smoke-public-site.mjs",
    "manuals:publish": "python3 ../transdoc-backend/scripts/publish_public_manuals.py --site ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
